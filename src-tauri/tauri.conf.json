{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hush",
  "version": "0.1.0",
  "identifier": "app.hush.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hush",
        "width": 1280,
        "height": 840,
        "minWidth": 1020,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0f1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A calm, minimal music player",
    "longDescription": "hush is a calm, minimal music player for Navidrome and Subsonic-compatible servers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
